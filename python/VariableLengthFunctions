)


# positional Argument + keyword Argument
#Imagine ordering pizza

def place_order(item,qty = 1,*toppings,**details):

    print(item)
    print(qty)

    for i in toppings:
        print(i)

    for k , v in details.items():
        print(k," : ",v)


place_order("Pizza",2,"Extra chees","seasoning",address = "Flat 48",cupons ="code123")


